{
  "name": "bounty-watch",
  "version": "0.1.0",
  "private": true,
  "description": "Polls Algora org boards for newly opened bounties, since Algora publishes no global feed.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bounty-watch": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node --experimental-strip-types src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

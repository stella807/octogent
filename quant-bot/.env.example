# Live trading is OFF unless both of these are set AND --live is passed.
# Paper trading and every backtest command need none of this.

# Gate 1: explicit confirmation that real funds are at risk.
QUANT_BOT_LIVE_CONFIRM=

# Gate 2: exchange credentials.
# Create a key with TRADE permission only. Never enable withdrawal.
# Restrict it by IP if your exchange supports that.
QUANT_BOT_API_KEY=
QUANT_BOT_API_SECRET=

# Optional: get a Telegram message on every buy, sell, stop, or risk halt in
# paper or live mode. Leave both blank to disable — paper trading with no
# credentials at all still works exactly as before.
# Create a bot with @BotFather, message it once, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates
QUANT_BOT_TELEGRAM_BOT_TOKEN=
QUANT_BOT_TELEGRAM_CHAT_ID=

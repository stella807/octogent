{
  "name": "freight-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "B2B freight marketplace connecting shippers with transportation suppliers: posting, transparent matching, bidding, negotiation, award and tracking.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --experimental-strip-types --experimental-sqlite --no-warnings src/main.ts",
    "dev": "node --experimental-strip-types --experimental-sqlite --no-warnings --watch src/main.ts",
    "seed": "node --experimental-strip-types --experimental-sqlite --no-warnings src/seed.ts",
    "test": "node --experimental-strip-types --experimental-sqlite --no-warnings --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3"
  }
}
